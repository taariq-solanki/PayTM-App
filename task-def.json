{
  "family": "paytm-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "paytm-backend",
      "image": "031857855591.dkr.ecr.ap-south-1.amazonaws.com/paytm-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "MONGO_URI",
          "value": "mongodb+srv://paytmUser:Npy0g2KNFDXo9xHy@paytmcluster.tqln6ay.mongodb.net/paytm?retryWrites=true&w=majority&appName=PaytmCluster"
        },
        {
          "name": "JWT_SECRET",
          "value": "your-super-secret-jwt-key-change-this-in-production"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
          
        }
      ]
    },
    {
      "name": "paytm-frontend",
      "image": "031857855591.dkr.ecr.ap-south-1.amazonaws.com/paytm-frontend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "executionRoleArn": "arn:aws:iam::031857855591:role/ecsTaskExecutionRole"
}
